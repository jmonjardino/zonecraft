{
  "name": "zonecraft",
  "version": "0.1.0",
  "private": true,
  "description": "Profile-based window layouts for GNOME Shell",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:shell": "make pack && dbus-run-session -- gnome-shell-test-tool --headless --disable-animations --extension build/releases/zonecraft@jmonjardino.dev.shell-extension.zip tests/shell-smoke.js",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "GPL-3.0-or-later"
}
